# Oracle Sentinel Environment Variables (Optional)
# If set, these will override default values in config.json

CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN_HERE
CLOUDFLARE_ZONE=example.com
CLOUDFLARE_RECORD=vps.example.com
OCI_CONFIG_PATH=/root/.oci/config
PORT=20540
HOST=0.0.0.0
SSL_KEYFILE=/root/cert/privkey.pem
SSL_CERTFILE=/root/cert/fullchain.pem
